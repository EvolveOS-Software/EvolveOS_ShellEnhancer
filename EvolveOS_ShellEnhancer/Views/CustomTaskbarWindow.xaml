<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomTaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CustomTaskbarWindow">

    <Grid Background="Transparent">
        <Border x:Name="TaskbarBorder"
                Background="Transparent" 
                BorderBrush="Transparent"
                BorderThickness="0" CornerRadius="0" 
                Height="48" Padding="16,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">

            <Grid>
                <!-- Left Panel -->
                <StackPanel x:Name="LeftPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" x:Name="BtnStart" Click="BtnStart_Click">
                        <FontIcon Glyph="&#xE737;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Center Panel -->
                <StackPanel x:Name="CenterPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="PinnedAppsPanel" Orientation="Horizontal" Spacing="8">
                    </StackPanel>
                </StackPanel>

                <!-- Right Panel (Tray & Clock) -->
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Chevron (Hidden Icons) -->
                    <Button Width="32" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnTrayOverflow_Click" ToolTipService.ToolTip="Show hidden icons">
                        <FontIcon Glyph="&#xE70D;" FontSize="14"/>
                    </Button>

                    <!-- Combined Quick Settings (Network & Volume) -->
                    <Button Height="40" Padding="12,0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnQuickSettings_Click" ToolTipService.ToolTip="Quick Settings">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE704;" FontSize="16"/>
                            <FontIcon Glyph="&#xE767;" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <!-- Clock & Date Button -->
                    <Button Padding="8,0" Height="40" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnClock_Click" ToolTipService.ToolTip="Notifications and Calendar">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" Text="00:00 AM" FontSize="12" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="DateText" Text="00/00/0000" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>