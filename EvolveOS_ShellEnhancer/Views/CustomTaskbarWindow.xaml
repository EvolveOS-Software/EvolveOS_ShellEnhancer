<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomTaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CustomTaskbarWindow">

    <Grid Background="#01000000">
        <Border x:Name="TaskbarBorder"
            Background="#20000000" 
            BorderBrush="Transparent"
            BorderThickness="0" CornerRadius="0" 
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"
            PointerWheelChanged="TaskbarBorder_PointerWheelChanged">

            <Grid>
                <!-- Left Panel -->
                <StackPanel x:Name="LeftPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" x:Name="BtnStart" Click="BtnStart_Click">
                        <Image Source="ms-appx:///Assets/StartMenuLogo.png" Width="24" Height="24"/>
                    </Button>
                </StackPanel>

                <!-- Center Panel -->
                <StackPanel x:Name="CenterPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="PinnedAppsPanelContainer" Orientation="Horizontal">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition IsStaggeringEnabled="True" />
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                        <StackPanel x:Name="PinnedAppsPanel" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Panel (Tray & Clock) -->
                <StackPanel x:Name="RightPanel" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- Chevron (Hidden Icons) -->
                    <Button x:Name="BtnChevron" MinWidth="44" Height="40" Padding="0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="BtnTrayOverflow_Click" ToolTipService.ToolTip="Show hidden icons">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Combined Quick Settings (Network & Volume) -->
                    <Button x:Name="BtnQuickSettings" MinWidth="44" Height="40" Padding="4,0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="BtnQuickSettings_Click" ToolTipService.ToolTip="Quick Settings">
                        <StackPanel x:Name="QuickSettingsIconsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE704;" FontSize="14"/>
                            <FontIcon Glyph="&#xE767;" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <!-- Clock & Date Button -->
                    <Button x:Name="BtnClock" MinWidth="44" Height="40" Padding="4,0" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="BtnClock_Click" ToolTipService.ToolTip="Notifications and Calendar">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <StackPanel x:Name="ClockContentPanel" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="ClockText" Text="00:00 AM" FontSize="{ThemeResource AppFontSizeBase}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                <TextBlock x:Name="DateText" Text="00/00" FontSize="{ThemeResource AppFontSizeSmall}" HorizontalAlignment="Right" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>