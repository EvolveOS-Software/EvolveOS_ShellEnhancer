<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomTaskbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CustomTaskbarWindow">

    <Grid Background="Transparent">
        <Border x:Name="TaskbarBorder"
                Background="Transparent" 
                BorderBrush="Transparent" 
                BorderThickness="0" CornerRadius="0" 
                Height="48" Padding="16,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">

            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" x:Name="BtnStart" Click="BtnStart_Click">
                        <FontIcon Glyph="&#xE737;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </Button>
                </StackPanel>

                <!-- Center aligned items (Pinned Apps) -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnExplorer_Click" ToolTipService.ToolTip="File Explorer">
                        <FontIcon Glyph="&#xE719;" FontSize="18"/>
                    </Button>
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnBrowser_Click" ToolTipService.ToolTip="Web Browser">
                        <FontIcon Glyph="&#xE7EF;" FontSize="18"/>
                    </Button>
                </StackPanel>

                <!-- Right aligned items (Tray & Clock) -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnNetwork_Click" ToolTipService.ToolTip="Network Settings">
                        <FontIcon Glyph="&#xE704;" FontSize="16"/>
                    </Button>
                    <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="8" Click="BtnVolume_Click" ToolTipService.ToolTip="Volume Mixer">
                        <FontIcon Glyph="&#xE767;" FontSize="16"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center" Margin="8,0">
                        <TextBlock x:Name="ClockText" Text="00:00 AM" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DateText" Text="00/00/0000" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>