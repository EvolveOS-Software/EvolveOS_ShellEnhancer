<Window
    x:Class="EvolveOS_ShellEnhancer.Views.PowerPlanFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_ShellEnhancer.Utilities.Helpers"
    xmlns:models="using:EvolveOS_ShellEnhancer.Models"
    mc:Ignorable="d">

    <Grid x:Name="RootPanel" Background="Transparent" Padding="12" Opacity="0" CornerRadius="8">
        <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
            <Grid Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,12">
                    <FontIcon Glyph="&#xEBB5;" FontSize="16"/>
                    <TextBlock Text="{helpers:ResourceString Key=SystemTray_PowerPlans}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <ListView x:Name="PlansList" Grid.Row="1" SelectionChanged="PlansList_SelectionChanged" SelectionMode="Single" Background="Transparent" CornerRadius="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PowerPlan">
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="4,8">
                                <RadioButton IsChecked="{x:Bind IsActive, Mode=OneTime}" IsHitTestVisible="False" MinWidth="0"/>
                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>