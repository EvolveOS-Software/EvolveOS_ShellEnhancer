<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.DesktopTabWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EvolveOS_ShellEnhancer.Models"
    xmlns:views="using:EvolveOS_ShellEnhancer.Views"
    xmlns:helpers="using:EvolveOS_ShellEnhancer.Utilities.Helpers"
    mc:Ignorable="d"
    Title="{helpers:ResourceString Key=DesktopTabWidgetTitle}">

    <Grid x:Name="RootPanel" Background="Transparent">

        <Grid.Resources>
            <DataTemplate x:Key="FlyoutFolderItemTemplate" x:DataType="models:AppItem">
                <StackPanel Width="76" Height="92" Margin="2" Spacing="4" Padding="2,2" CornerRadius="8" Background="{x:Bind TileBrush, Mode=OneWay}"
                            RightTapped="AppCard_RightTapped" PointerPressed="AppCard_PointerPressed"
                            PointerEntered="AppCard_PointerEntered" PointerExited="AppCard_PointerExited">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind StandardNoIconVisibility, Mode=OneWay}" Foreground="{x:Bind TintBrush, Mode=OneWay, TargetNullValue={ThemeResource TextFillColorPrimaryBrush}}"/>
                        <Image Source="{x:Bind ActiveIconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind StandardIconVisibility, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="{ThemeResource AppFontSizeSmall}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>

        <!-- Main Container -->
        <Grid x:Name="MenuContainer" Background="Transparent" PointerMoved="MenuContainer_PointerMoved" PointerReleased="MenuContainer_PointerReleased" PointerCanceled="MenuContainer_PointerReleased">

            <!-- Widget Background Context Menu -->
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutSubItem Text="{helpers:ResourceString Key=WidgetSize}">
                        <MenuFlyoutSubItem.Icon>
                            <FontIcon Glyph="&#xE740;" />
                        </MenuFlyoutSubItem.Icon>
                        <RadioMenuFlyoutItem x:Name="SizeCustomOption" Text="{helpers:ResourceString Key=WidgetSizeCustom}" GroupName="WidgetSizeGroup" Click="WidgetSize_Click" Tag="Custom"/>
                        <RadioMenuFlyoutItem x:Name="SizeMediumOption" Text="{helpers:ResourceString Key=WidgetSizeMedium}" GroupName="WidgetSizeGroup" IsChecked="True" Click="WidgetSize_Click" Tag="Medium"/>
                        <RadioMenuFlyoutItem x:Name="SizeLargeOption" Text="{helpers:ResourceString Key=WidgetSizeLarge}" GroupName="WidgetSizeGroup" Click="WidgetSize_Click" Tag="Large"/>
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{helpers:ResourceString Key=CloseWidget}" Click="CloseWidget_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Grid.ContextFlyout>

            <Border Background="Transparent"
                    BorderThickness="0" 
                    Padding="16,12"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch"
                    PointerPressed="Widget_PointerPressed">

                <StackPanel Spacing="12" HorizontalAlignment="Stretch">

                    <!-- Tab Headers -->
                    <ListView ItemsSource="{x:Bind ParentCategory.Tabs}" 
                              SelectedIndex="{x:Bind ParentCategory.SelectedTabIndex, Mode=TwoWay}" 
                              SelectionMode="Single" 
                              ScrollViewer.HorizontalScrollMode="Disabled" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              Margin="0" 
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Background="{ThemeResource StartMenuGlassBrush}" CornerRadius="8" Padding="4" Spacing="4" HorizontalAlignment="Stretch" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="24,6"/>
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppCategory">
                                <Grid Background="Transparent">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <Border Height="3" Background="{x:Bind TabColorBrush, Mode=OneWay}" VerticalAlignment="Bottom" CornerRadius="1.5" Margin="0,20,0,-6" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- App Grid -->
                    <GridView x:Name="MainAppGrid"
                              ItemsSource="{x:Bind SelectedTabApps, Mode=OneWay}" 
                              SelectionMode="Single" 
                              IsItemClickEnabled="True" 
                              ItemClick="AppGrid_ItemClick"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              HorizontalAlignment="Stretch">

                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
                        </GridView.Resources>

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid x:Name="MainAppWrapGrid" Orientation="Vertical" MaximumRowsOrColumns="1" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppItem">
                                <Border Tag="{x:Bind}" Width="88" Height="104" Padding="4,12,4,8" CornerRadius="8" Background="{x:Bind TileBrush, Mode=OneWay}"
                                        RightTapped="AppCard_RightTapped" PointerPressed="AppCard_PointerPressed" PointerEntered="AppCard_PointerEntered" PointerExited="AppCard_PointerExited">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <Grid Width="48" Height="48">
                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind StandardNoIconVisibility, Mode=OneWay}" Foreground="{x:Bind TintBrush, Mode=OneWay, TargetNullValue={ThemeResource TextFillColorPrimaryBrush}}"/>
                                            <Image Source="{x:Bind ActiveIconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind StandardIconVisibility, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                </Image.RenderTransform>
                                            </Image>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Visibility="{x:Bind AppNameVisibility, Mode=OneWay}" FontSize="{ThemeResource AppFontSizeSmall}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- Bottom Navigation (< • • • >) -->
                    <Grid x:Name="BottomNavigationGrid" HorizontalAlignment="Center" Height="28" PointerWheelChanged="BottomNavigationGrid_PointerWheelChanged">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="PageLeftBtn" FontFamily="Segoe Fluent Icons" Content="&#xE76B;" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="4" Click="PageLeftBtn_Click"/>

                            <ItemsControl x:Name="PageIndicatorControl" ItemsSource="{x:Bind PageDots}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WidgetPageDot">
                                        <Button Background="Transparent" Padding="4" BorderThickness="0" MinWidth="0" MinHeight="0"
                                                Click="PageDotIndicator_Click" Tag="{x:Bind PageIndex}"
                                                PointerEntered="DotIndicator_PointerEntered" PointerExited="DotIndicator_PointerExited">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                            </Button.Resources>
                                            <Ellipse Width="{x:Bind IndicatorSize, Mode=OneWay}"
                                                     Height="{x:Bind IndicatorSize, Mode=OneWay}"
                                                     Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                                     Opacity="{x:Bind IndicatorOpacity, Mode=OneWay}"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="PageRightBtn" FontFamily="Segoe Fluent Icons" Content="&#xE76C;" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="4" Click="PageRightBtn_Click"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- Custom Drag Resize Handle -->
            <Grid x:Name="ResizeHandle" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                  Background="Transparent" Canvas.ZIndex="1000" Visibility="Collapsed" 
                  PointerPressed="ResizeHandle_PointerPressed" PointerMoved="ResizeHandle_PointerMoved" PointerReleased="ResizeHandle_PointerReleased">
                <FontIcon Glyph="&#xE76F;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" IsHitTestVisible="False"/>
            </Grid>

        </Grid>

        <!-- Drag Canvas -->
        <Canvas x:Name="DragCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="9999"/>

        <!-- Folder Overlay Popup -->
        <Grid x:Name="PinnedFolderOverlay" Visibility="Collapsed" Background="Transparent" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="10000"
              PointerPressed="CloseFolderOverlay_PointerPressed" Opacity="0">
            <Grid.Resources>
                <Storyboard x:Name="FolderOverlayEnterAnimation">
                    <DoubleAnimation Storyboard.TargetName="PinnedFolderOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
                <Storyboard x:Name="FolderOverlayExitAnimation">
                    <DoubleAnimation Storyboard.TargetName="PinnedFolderOverlay" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.95" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleY" From="1" To="0.95" Duration="0:0:0.15" />
                </Storyboard>
            </Grid.Resources>

            <Border x:Name="FolderPopupCard" Width="420" Height="376" CornerRadius="12"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <SolidColorBrush Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.80"/>
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FolderPopupScale" ScaleX="0.9" ScaleY="0.9" />
                </Border.RenderTransform>

                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="OverlayFolderNameBox" Grid.Row="0" FontWeight="SemiBold" FontSize="16" 
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                             HorizontalAlignment="Center" TextAlignment="Center" MinWidth="200"
                             KeyDown="OverlayFolderNameBox_KeyDown" LostFocus="OverlayFolderNameBox_LostFocus">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                        </TextBox.Resources>
                    </TextBox>
                    <GridView x:Name="OverlayFolderGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                              HorizontalAlignment="Center" Padding="8"
                              ItemTemplate="{StaticResource FlyoutFolderItemTemplate}"
                              ItemClick="OverlayFolderGrid_ItemClick"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled">

                        <GridView.Resources>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
                        </GridView.Resources>

                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>