<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomStartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_ShellEnhancer.Utilities.Helpers"
    xmlns:models="using:EvolveOS_ShellEnhancer.Models"
    mc:Ignorable="d"
    Title="CustomStartMenuWindow">

    <Grid>

        <Grid Background="Transparent" PointerPressed="DismissLayer_PointerPressed" />

        <Grid Width="750" Height="650" HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <!-- Floating Menu Container -->
            <Border Background="Transparent" 
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="12" 
                    x:Name="MenuContainer"
                    PointerMoved="MenuContainer_PointerMoved"
                    PointerReleased="MenuContainer_PointerReleased"
                    PointerCanceled="MenuContainer_PointerReleased">

                <Grid>
                    <!-- 1: Split Standard -->
                    <Grid x:Name="DesignSplitStandard" Visibility="Visible">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Pane: Apps & Search -->
                        <Grid Grid.Column="0" Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox x:Name="SearchBox1" Height="40" PlaceholderText="{helpers:ResourceString Key=StartMenu_SearchPlaceholder}"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4"
                                                VerticalContentAlignment="Center"
                                                TextChanged="SearchBox_TextChanged">
                                    <AutoSuggestBox.QueryIcon>
                                        <SymbolIcon Symbol="Find"/>
                                    </AutoSuggestBox.QueryIcon>
                                </AutoSuggestBox>

                                <DropDownButton x:Name="FilterCombo1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                                    <DropDownButton.Content>
                                        <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_FilterApps}" Click="SearchFilter_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_FilterFiles}" Click="SearchFilter_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_FilterWeb}" Click="SearchFilter_Click"/>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>

                            <!-- Pinned Apps / Search Results / Recent Docs -->
                            <Grid Grid.Row="1" Margin="0,24,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Button Content="{helpers:ResourceString Key=StartMenu_AllApps}" Background="Transparent" BorderThickness="0" 
                                            HorizontalAlignment="Right" FontSize="{ThemeResource AppFontSizeSmall}" Click="BtnAllApps_Click"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" RightTapped="ScrollViewer_RightTapped" Background="Transparent">
                                    <StackPanel Spacing="16" Background="Transparent" MinHeight="300" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                        <!-- Dynamic Pinned Categories -->
                                        <ItemsControl x:Name="PinnedCategoriesControl" ItemsSource="{x:Bind PinnedCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppCategory">
                                                    <StackPanel Margin="0,0,0,16">

                                                        <TextBox Text="{x:Bind Name, Mode=TwoWay}" 
                                                                 LostFocus="CategoryName_LostFocus" 
                                                                 KeyDown="CategoryName_KeyDown"
                                                                 Background="Transparent" 
                                                                 BorderThickness="0" 
                                                                 PlaceholderText="Category Name"
                                                                 FontWeight="SemiBold" 
                                                                 FontSize="{ThemeResource AppFontSizeHeader}" 
                                                                 Padding="0"
                                                                 Margin="0,0,0,8">
                                                            <TextBox.Resources>
                                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                                            </TextBox.Resources>
                                                            <TextBox.ContextFlyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem Text="Delete Section" Click="DeleteCategory_Click" Tag="{x:Bind}">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE74D;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </TextBox.ContextFlyout>
                                                        </TextBox>

                                                        <GridView DataContext="{Binding}" 
                                                                  ItemsSource="{x:Bind Apps}" 
                                                                  SelectionMode="Single" 
                                                                  IsItemClickEnabled="True" 
                                                                  ItemClick="AppGrid_ItemClick" 
                                                                  SelectionChanged="AppGrid_SelectionChanged">
                                                            <GridView.ItemTemplate>
                                                                <DataTemplate x:DataType="models:AppItem">
                                                                    <StackPanel Tag="{x:Bind}" Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent" 
                                                                                RightTapped="AppCard_RightTapped"
                                                                                PointerPressed="AppCard_PointerPressed"
                                                                                PointerEntered="AppCard_PointerEntered"
                                                                                PointerExited="AppCard_PointerExited">
                                                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center" Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                            <Image.RenderTransform>
                                                                                <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                            </Image.RenderTransform>
                                                                        </Image>
                                                                        <TextBlock Text="{x:Bind Name}" FontSize="{ThemeResource AppFontSizeSmall}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </GridView.ItemTemplate>
                                                        </GridView>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Search Results & All Apps -->
                                        <ListView x:Name="SearchAndAllAppsGrid" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" SelectionChanged="AppGrid_SelectionChanged">

                                            <ListView.Resources>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent"/>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent"/>
                                            </ListView.Resources>

                                            <ListView.ItemContainerTransitions>
                                                <TransitionCollection>
                                                    <AddDeleteThemeTransition />
                                                </TransitionCollection>
                                            </ListView.ItemContainerTransitions>

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppItem">
                                                    <Border Tag="{x:Bind}" HorizontalAlignment="Stretch" Height="44" Margin="{x:Bind ItemMargin, Mode=OneWay}" CornerRadius="6" Background="Transparent"
                                                            RightTapped="AppCard_RightTapped"
                                                            PointerPressed="AppCard_PointerPressed"
                                                            PointerEntered="AppCard_PointerEntered"
                                                            PointerExited="AppCard_PointerExited">
                                                        <Grid ColumnSpacing="12" Padding="8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <FontIcon Grid.Column="0" Glyph="{x:Bind FallbackGlyph}" FontSize="20" HorizontalAlignment="Center" Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                            <Image Grid.Column="0" Source="{x:Bind IconSource, Mode=OneWay}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                </Image.RenderTransform>
                                                            </Image>

                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="{ThemeResource AppFontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxLines="1"/>

                                                            <FontIcon x:Name="ChevronIcon" Grid.Column="2" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{x:Bind IsFolderItem, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                <FontIcon.RenderTransform>
                                                                    <RotateTransform x:Name="ChevronTransform" Angle="{x:Bind ChevronAngle, Mode=OneWay}"/>
                                                                </FontIcon.RenderTransform>
                                                            </FontIcon>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <!-- Recent Documents -->
                                        <StackPanel x:Name="RecentDocsPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="Recent Documents" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}" VerticalAlignment="Center"/>
                                                <Button x:Name="RecentDocsMoreBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,6" CornerRadius="4" Click="RecentDocsMoreBtn_Click" Visibility="Collapsed">
                                                    <FontIcon x:Name="RecentDocsChevron" Glyph="&#xE70D;" FontSize="12"/>
                                                </Button>
                                            </Grid>

                                            <GridView ItemsSource="{x:Bind RecentDocsCollection}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick">
                                                <GridView.ItemContainerStyle>
                                                    <Style TargetType="GridViewItem">
                                                        <Setter Property="Margin" Value="0,0,6,6"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                </GridView.ItemContainerStyle>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AppItem">
                                                        <Border Tag="{x:Bind}" Width="210" Height="52" Padding="8,0" CornerRadius="6" Background="Transparent" 
                                                                RightTapped="AppCard_RightTapped"
                                                                PointerPressed="AppCard_PointerPressed"
                                                                PointerEntered="AppCard_PointerEntered"
                                                                PointerExited="AppCard_PointerExited">
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="32"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <FontIcon Grid.Column="0" Glyph="{x:Bind FallbackGlyph}" FontSize="24" HorizontalAlignment="Center" Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                                <Image Grid.Column="0" Source="{x:Bind IconSource, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneWay}"/>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Name}" FontSize="{ThemeResource AppFontSizeSmall}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                                    <TextBlock Text="{x:Bind ExecutablePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <!-- Right Pane -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,12,12,0" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid Padding="24">

                                <!-- Default System Actions View -->
                                <Grid x:Name="DefaultRightPane1" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Quick Folders -->
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Documents" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderDocuments}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Downloads" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderDownloads}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Music" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderMusic}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Pictures" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderPictures}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Settings" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderSettings}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Run" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE78B;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderRun}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Power Options 1 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <DropDownButton Background="Transparent" BorderThickness="0">
                                            <DropDownButton.Content>
                                                <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                                            </DropDownButton.Content>
                                            <DropDownButton.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Name="PowerItemSleep1" Text="{helpers:ResourceString Key=StartMenu_PowerSleep}" Click="PowerSleep_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE708;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="PowerItemLogOff1" Text="{helpers:ResourceString Key=StartMenu_PowerLogOff}" Click="PowerLogOff_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE77B;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="PowerItemRestartBios1" Text="{helpers:ResourceString Key=StartMenu_PowerRestartBios}" Click="PowerRestartBios_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE9A1;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_PowerShutdown}" Click="PowerShutdown_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE7E8;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_PowerRestart}" Click="PowerRestart_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE777;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Search Action View -->
                                <Grid x:Name="SearchRightPane1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="16" Margin="0,72,0,24">
                                        <Image x:Name="SearchDetailsIcon1" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="SearchDetailsName1" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>

                                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,16"/>

                                    <StackPanel Grid.Row="2" Spacing="2">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_Open_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_ActionOpen}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AdminBtn1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_RunAsAdmin_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE7EF;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_ActionRunAsAdmin}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="LocationBtn1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_OpenLocation_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_ActionOpenLocation}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </Border>
                    </Grid>


                    <!-- 2: Split Grouped -->
                    <Grid x:Name="DesignSplitGrouped" Visibility="Collapsed">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Pane: Cards & Search -->
                        <Grid Grid.Column="0" Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Search -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox x:Name="SearchBox2" Height="40" PlaceholderText="{helpers:ResourceString Key=StartMenu_SearchPlaceholder}"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4"
                                                VerticalContentAlignment="Center"
                                                TextChanged="SearchBox_TextChanged">
                                    <AutoSuggestBox.QueryIcon>
                                        <SymbolIcon Symbol="Find"/>
                                    </AutoSuggestBox.QueryIcon>
                                </AutoSuggestBox>

                                <DropDownButton x:Name="FilterCombo2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0" CornerRadius="4">
                                    <DropDownButton.Content>
                                        <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_FilterApps}" Click="SearchFilter_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_FilterFiles}" Click="SearchFilter_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_FilterWeb}" Click="SearchFilter_Click"/>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>

                            <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Hidden">
                                <StackPanel Spacing="16">
                                    <!-- Category Card 1 -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_CategoryProductivity}" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}"/>
                                                <Button Content="{helpers:ResourceString Key=StartMenu_AllApps}" Background="Transparent" BorderThickness="0" 
                                                        HorizontalAlignment="Right" FontSize="{ThemeResource AppFontSizeSmall}" Click="BtnAllApps_Click"/>
                                            </Grid>
                                            <GridView x:Name="ProductivityAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" SelectionChanged="AppGrid_SelectionChanged">
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AppItem">
                                                        <StackPanel Tag="{x:Bind}" Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent" 
                                                                    RightTapped="AppCard_RightTapped"
                                                                    PointerPressed="AppCard_PointerPressed"
                                                                    PointerEntered="AppCard_PointerEntered"
                                                                    PointerExited="AppCard_PointerExited">
                                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                            <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                </Image.RenderTransform>
                                                            </Image>
                                                            <TextBlock Text="{x:Bind Name}" FontSize="{ThemeResource AppFontSizeSmall}" HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </Border>

                                    <!-- Category Card 2 -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_CategoryNotes}" FontSize="{ThemeResource AppFontSizeBase}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_CategoryGames}" FontSize="{ThemeResource AppFontSizeBase}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_CategoryPhoto}" FontSize="{ThemeResource AppFontSizeBase}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <GridView x:Name="SecondaryAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" SelectionChanged="AppGrid_SelectionChanged">
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AppItem">
                                                        <StackPanel Tag="{x:Bind}" Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent" 
                                                                    RightTapped="AppCard_RightTapped"
                                                                    PointerPressed="AppCard_PointerPressed"
                                                                    PointerEntered="AppCard_PointerEntered"
                                                                    PointerExited="AppCard_PointerExited">
                                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                            <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                </Image.RenderTransform>
                                                            </Image>
                                                            <TextBlock Text="{x:Bind Name}" FontSize="{ThemeResource AppFontSizeSmall}" HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Right Pane -->
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,12,12,0" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                            <Grid Padding="24">

                                <!-- Default System Actions View -->
                                <Grid x:Name="DefaultRightPane2" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Quick Folders -->
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Documents" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderDocuments}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Downloads" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderDownloads}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Music" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderMusic}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Pictures" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderPictures}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Settings" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderSettings}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Run" Click="QuickFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE78B;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_FolderRun}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Power Options 2 -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <DropDownButton Background="Transparent" BorderThickness="0">
                                            <DropDownButton.Content>
                                                <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                                            </DropDownButton.Content>
                                            <DropDownButton.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Name="PowerItemSleep2" Text="{helpers:ResourceString Key=StartMenu_PowerSleep}" Click="PowerSleep_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE708;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="PowerItemLogOff2" Text="{helpers:ResourceString Key=StartMenu_PowerLogOff}" Click="PowerLogOff_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE77B;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="PowerItemRestartBios2" Text="{helpers:ResourceString Key=StartMenu_PowerRestartBios}" Click="PowerRestartBios_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE9A1;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_PowerShutdown}" Click="PowerShutdown_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE7E8;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=StartMenu_PowerRestart}" Click="PowerRestart_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE777;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </DropDownButton.Flyout>
                                        </DropDownButton>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Search Action View -->
                                <Grid x:Name="SearchRightPane2" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="16" Margin="0,72,0,24">
                                        <Image x:Name="SearchDetailsIcon2" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="SearchDetailsName2" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>

                                    <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,16"/>

                                    <StackPanel Grid.Row="2" Spacing="2">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_Open_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_ActionOpen}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AdminBtn2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_RunAsAdmin_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE7EF;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_ActionRunAsAdmin}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="LocationBtn2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_OpenLocation_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                <TextBlock Text="{helpers:ResourceString Key=StartMenu_ActionOpenLocation}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </Border>
                    </Grid>

                    <Canvas x:Name="DragCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="9999"/>

                </Grid>
            </Border>

            <!-- Profile Badge -->
            <Grid Width="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0">

                <Popup x:Name="AvatarPopup" IsOpen="False" ShouldConstrainToRootBounds="False" VerticalOffset="-44" HorizontalOffset="0">
                    <Grid Width="260">

                        <Grid.Resources>
                            <Storyboard x:Name="ProfileGrowStoryboard">
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                            <Storyboard x:Name="ProfileShrinkStoryboard">
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>

                        <Button x:Name="ProfileButton" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Padding="8" CornerRadius="8"
                                Click="ProfileButton_Click" PointerEntered="ProfileButton_PointerEntered" PointerExited="ProfileButton_PointerExited">

                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>

                            <!-- User Info Badge -->
                            <StackPanel Spacing="12" IsHitTestVisible="False">
                                <PersonPicture x:Name="UnifiedProfilePic" Height="88" Width="88" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <PersonPicture.RenderTransform>
                                        <ScaleTransform x:Name="ProfilePicScale" ScaleX="1" ScaleY="1" />
                                    </PersonPicture.RenderTransform>
                                </PersonPicture>
                                <TextBlock x:Name="UnifiedProfileName" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Popup>

            </Grid>

        </Grid>
    </Grid>
</Window>