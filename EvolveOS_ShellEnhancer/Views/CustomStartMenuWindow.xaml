<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomStartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_ShellEnhancer.Utilities.Helpers"
    mc:Ignorable="d"
    Title="CustomStartMenuWindow">

    <Grid Background="Transparent" PointerPressed="RootGrid_PointerPressed">

        <!-- Floating Menu Container -->
        <Border Background="Transparent" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="12" 
                Height="650" Width="750" x:Name="MenuContainer"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                PointerPressed="MenuContainer_PointerPressed">

            <Grid>
                <!-- ========================================== -->
                <!-- 1: Split Standard -->
                <!-- ========================================== -->
                <Grid x:Name="DesignSplitStandard" Visibility="Visible">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Pane: Apps & Search -->
                    <Grid Grid.Column="0" Padding="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <AutoSuggestBox x:Name="SearchBox1" Height="40" PlaceholderText="Search Apps and files"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4"
                                            VerticalContentAlignment="Center"
                                            TextChanged="SearchBox_TextChanged">
                                <AutoSuggestBox.QueryIcon>
                                    <SymbolIcon Symbol="Find"/>
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>

                            <DropDownButton x:Name="FilterCombo1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" CornerRadius="4">
                                <DropDownButton.Content>
                                    <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Apps" Click="SearchFilter_Click"/>
                                        <MenuFlyoutItem Text="Files" Click="SearchFilter_Click"/>
                                        <MenuFlyoutItem Text="Web" Click="SearchFilter_Click"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <!-- Pinned Apps / Search Results (FIXED SCROLLING HERE) -->
                        <Grid Grid.Row="1" Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <Button Content="All apps >" Background="Transparent" BorderThickness="0" 
                                            HorizontalAlignment="Right" FontSize="12" Click="BtnAllApps_Click"/>
                            </Grid>

                            <GridView Grid.Row="1" x:Name="StandardPinnedAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" SelectionChanged="AppGrid_SelectionChanged">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:AppItem">
                                        <StackPanel Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent">
                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                          Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>

                                            <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                       Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                </Image.RenderTransform>
                                            </Image>

                                            <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Grid>

                    <!-- Right Pane -->
                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,12,12,0" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid Padding="24">

                            <!-- Default System Actions View -->
                            <Grid x:Name="DefaultRightPane1" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Profile (Restored to its proper inline position) -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,24">
                                    <PersonPicture x:Name="ProfilePic1" Height="88" Width="88"/>
                                    <TextBlock x:Name="ProfileName1" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Quick Folders -->
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Documents" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                            <TextBlock Text="Documents"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Downloads" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                            <TextBlock Text="Downloads"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Music" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                                            <TextBlock Text="Music"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Pictures" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                            <TextBlock Text="Pictures"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Settings" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                            <TextBlock Text="Settings"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Run" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE78B;" FontSize="16"/>
                                            <TextBlock Text="Run..."/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Power Options -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <DropDownButton Background="Transparent" BorderThickness="0">
                                        <DropDownButton.Content>
                                            <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                                        </DropDownButton.Content>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Sleep" Click="PowerSleep_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE708;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Shut down" Click="PowerShutdown_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE7E8;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Restart" Click="PowerRestart_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE777;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>

                            <!-- Live Search Action View -->
                            <Grid x:Name="SearchRightPane1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="16" Margin="0,12,0,24">
                                    <Image x:Name="SearchDetailsIcon1" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="SearchDetailsName1" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>

                                <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,16"/>

                                <StackPanel Grid.Row="2" Spacing="2">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_Open_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                            <TextBlock Text="Open"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AdminBtn1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_RunAsAdmin_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE7EF;" FontSize="16"/>
                                            <TextBlock Text="Run as administrator"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LocationBtn1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_OpenLocation_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                            <TextBlock Text="Open file location"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>


                <!-- ========================================== -->
                <!-- 2: Split Grouped -->
                <!-- ========================================== -->
                <Grid x:Name="DesignSplitGrouped" Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Pane: Cards & Search -->
                    <Grid Grid.Column="0" Padding="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <AutoSuggestBox x:Name="SearchBox2" Height="40" PlaceholderText="Search Apps and files"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4"
                                            VerticalContentAlignment="Center"
                                            TextChanged="SearchBox_TextChanged">
                                <AutoSuggestBox.QueryIcon>
                                    <SymbolIcon Symbol="Find"/>
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>

                            <DropDownButton x:Name="FilterCombo2" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" CornerRadius="4">
                                <DropDownButton.Content>
                                    <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                </DropDownButton.Content>
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Apps" Click="SearchFilter_Click"/>
                                        <MenuFlyoutItem Text="Files" Click="SearchFilter_Click"/>
                                        <MenuFlyoutItem Text="Web" Click="SearchFilter_Click"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Spacing="16">
                                <!-- Category Card 1 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Productivity" FontWeight="SemiBold" FontSize="14"/>
                                            <Button Content="All apps >" Background="Transparent" BorderThickness="0" 
                                                        HorizontalAlignment="Right" FontSize="12" Click="BtnAllApps_Click"/>
                                        </Grid>
                                        <GridView x:Name="ProductivityAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" SelectionChanged="AppGrid_SelectionChanged">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="helpers:AppItem">
                                                    <StackPanel Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent">
                                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Border>

                                <!-- Category Card 2 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                                            <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Games" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="Photo" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <GridView x:Name="SecondaryAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick" SelectionChanged="AppGrid_SelectionChanged">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="helpers:AppItem">
                                                    <StackPanel Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent">
                                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Pane -->
                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,12,12,0" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid Padding="24">

                            <!-- Default System Actions View -->
                            <Grid x:Name="DefaultRightPane2" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Profile (Restored to its proper inline position) -->
                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,24">
                                    <PersonPicture x:Name="ProfilePic2" Height="88" Width="88"/>
                                    <TextBlock x:Name="ProfileName2" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Quick Folders -->
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Documents" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                            <TextBlock Text="Documents"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Downloads" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                            <TextBlock Text="Downloads"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Music" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                                            <TextBlock Text="Music"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Pictures" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                            <TextBlock Text="Pictures"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Settings" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                            <TextBlock Text="Settings"/>
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Run" Click="QuickFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE78B;" FontSize="16"/>
                                            <TextBlock Text="Run..."/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Power Options -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <DropDownButton Background="Transparent" BorderThickness="0">
                                        <DropDownButton.Content>
                                            <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                                        </DropDownButton.Content>
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Sleep" Click="PowerSleep_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE708;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Shut down" Click="PowerShutdown_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE7E8;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Restart" Click="PowerRestart_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE777;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>

                            <!-- Live Search Action View -->
                            <Grid x:Name="SearchRightPane2" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="16" Margin="0,12,0,24">
                                    <Image x:Name="SearchDetailsIcon2" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="SearchDetailsName2" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>

                                <MenuFlyoutSeparator Grid.Row="1" Margin="0,0,0,16"/>

                                <StackPanel Grid.Row="2" Spacing="2">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_Open_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                            <TextBlock Text="Open"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AdminBtn2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_RunAsAdmin_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE7EF;" FontSize="16"/>
                                            <TextBlock Text="Run as administrator"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LocationBtn2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Click="SearchAction_OpenLocation_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                            <TextBlock Text="Open file location"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>