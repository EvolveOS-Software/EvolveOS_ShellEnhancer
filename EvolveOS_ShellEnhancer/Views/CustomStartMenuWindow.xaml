                                                                <DataTemplate x:DataType="models:AppItem">
                                                                    <Border Tag="{x:Bind}" HorizontalAlignment="Stretch" Height="44" Margin="32,0,0,4" CornerRadius="6" Background="Transparent"
                                                                            RightTapped="AppCard_RightTapped" PointerPressed="AppCard_PointerPressed" PointerEntered="AppCard_PointerEntered" PointerExited="AppCard_PointerExited">
                                                                        <Grid ColumnSpacing="12" Padding="8,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="32"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <FontIcon Grid.Column="0" Glyph="{x:Bind FallbackGlyph}" FontSize="20" HorizontalAlignment="Center" Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                                            <Image Grid.Column="0" Source="{x:Bind IconSource, Mode=OneWay}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                                <Image.RenderTransform>
                                                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                                </Image.RenderTransform>
                                                                            </Image>
                                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="{ThemeResource AppFontSizeSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxLines="1"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Full Width Search Overlay -->
                        <Grid x:Name="SearchOverlay2" Grid.Row="1" Visibility="Collapsed" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Wide Search Box -->
                            <AutoSuggestBox x:Name="SearchBox2" Grid.Row="0" Height="40" Margin="24,16,24,0"
                                            PlaceholderText="{helpers:ResourceString Key=StartMenu_SearchPlaceholderWide}"
                                            CornerRadius="20" VerticalContentAlignment="Center"
                                            TextChanged="SearchBox_TextChanged">
                                <AutoSuggestBox.QueryIcon>
                                    <SymbolIcon Symbol="Find"/>
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>

                            <!-- Search Results ScrollViewer -->
                            <ScrollViewer Grid.Row="1" Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="24">

                                    <!-- Web Search Hint -->
                                    <Button x:Name="WebSearchHintBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="8,4" CornerRadius="4" Click="WebSearchHintBtn_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="WebSearchHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Apps Section -->
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="{helpers:ResourceString Key=StartMenu_AppsTitle}" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}" VerticalAlignment="Center"/>
                                            <Button x:Name="SearchAppsMoreBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,6" CornerRadius="4" Click="SearchAppsMoreBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock x:Name="SearchAppsMoreText" Text="{helpers:ResourceString Key=StartMenu_More}" FontSize="12" VerticalAlignment="Center"/>
                                                    <FontIcon x:Name="SearchAppsMoreIcon" Glyph="&#xE70D;" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <GridView x:Name="SearchAppsGrid" ItemsSource="{x:Bind SearchAppsCollection, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick"
                                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" MaxHeight="116">
                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Margin" Value="0,0,8,12"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </GridView.ItemContainerStyle>
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppItem">
                                                    <StackPanel Tag="{x:Bind}" Width="104" Height="104" Spacing="8" Background="Transparent"
                                                                RightTapped="AppCard_RightTapped" PointerPressed="AppCard_PointerPressed" PointerEntered="AppCard_PointerEntered" PointerExited="AppCard_PointerExited">
                                                        <Border Width="64" Height="64" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}" HorizontalAlignment="Center">
                                                            <Grid>
                                                                <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                                <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                    <Image.RenderTransform>
                                                                        <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                    </Image.RenderTransform>
                                                                </Image>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>

                                    <!-- Settings Section -->
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <TextBlock Text="{helpers:ResourceString Key=StartMenu_SettingsTitle}" FontWeight="SemiBold" FontSize="{ThemeResource AppFontSizeHeader}" VerticalAlignment="Center"/>
                                            <Button x:Name="SearchSettingsMoreBtn" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,6" CornerRadius="4" Click="SearchSettingsMoreBtn_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock x:Name="SearchSettingsMoreText" Text="{helpers:ResourceString Key=StartMenu_More}" FontSize="12" VerticalAlignment="Center"/>
                                                    <FontIcon x:Name="SearchSettingsMoreIcon" Glyph="&#xE70D;" FontSize="11" RenderTransformOrigin="0.5,0.5">
                                                        <FontIcon.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </FontIcon.RenderTransform>
                                                    </FontIcon>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <GridView x:Name="SearchSettingsGrid" ItemsSource="{x:Bind SearchSettingsCollection, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick"
                                                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" MaxHeight="208">

                                            <GridView.Resources>
                                                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/>
                                                <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent"/>
                                                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent"/>
                                                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent"/>
                                            </GridView.Resources>

                                            <GridView.ItemContainerStyle>
                                                <Style TargetType="GridViewItem">
                                                    <Setter Property="Margin" Value="0,0,12,12"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </GridView.ItemContainerStyle>
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:AppItem">
                                                    <Border Tag="{x:Bind}" Width="192" Padding="8" Background="Transparent" CornerRadius="6"
                                                            RightTapped="AppCard_RightTapped" PointerPressed="AppCard_PointerPressed" PointerEntered="AppCard_PointerEntered" PointerExited="AppCard_PointerExited">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <FontIcon Grid.Column="0" Glyph="{x:Bind FallbackGlyph}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                            <Image Grid.Column="0" Source="{x:Bind IconSource, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                                <Image.RenderTransform>
                                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                                </Image.RenderTransform>
                                                            </Image>

                                                            <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Canvas x:Name="DragCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="9999"/>

                </Grid>
            </Grid>

            <!-- Profile Badge -->
            <Grid Width="260" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0">

                <Popup x:Name="AvatarPopup" IsOpen="False" ShouldConstrainToRootBounds="False" VerticalOffset="-44" HorizontalOffset="0">
                    <Grid Width="260">

                        <Grid.Resources>
                            <Storyboard x:Name="ProfileGrowStoryboard">
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                            <Storyboard x:Name="ProfileShrinkStoryboard">
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ProfilePicScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>

                        <Button x:Name="ProfileButton" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Padding="8" CornerRadius="8"
                                Click="ProfileButton_Click" PointerEntered="ProfileButton_PointerEntered" PointerExited="ProfileButton_PointerExited">

                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </Button.Resources>

                            <!-- User Info Badge -->
                            <StackPanel Spacing="12" IsHitTestVisible="False">
                                <PersonPicture x:Name="UnifiedProfilePic" Height="88" Width="88" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <PersonPicture.RenderTransform>
                                        <ScaleTransform x:Name="ProfilePicScale" ScaleX="1" ScaleY="1" />
                                    </PersonPicture.RenderTransform>
                                </PersonPicture>
                                <TextBlock x:Name="UnifiedProfileName"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="{ThemeResource AppFontSizeHeader}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Popup>

            </Grid>

        </Grid>

        <!-- Pinned Folder Overlay (Animated) -->
        <Grid x:Name="PinnedFolderOverlay" Visibility="Collapsed" Background="#80000000" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="10000"
              PointerPressed="CloseFolderOverlay_PointerPressed" Opacity="0">

            <!-- Animation Definitions -->
            <Grid.Resources>
                <Storyboard x:Name="FolderOverlayEnterAnimation">
                    <!-- Background Fade In -->
                    <DoubleAnimation Storyboard.TargetName="PinnedFolderOverlay" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Popup Zoom In -->
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleX" From="0.9" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleY" From="0.9" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <ExponentialEase EasingMode="EaseOut" Exponent="5" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>

                <Storyboard x:Name="FolderOverlayExitAnimation">
                    <!-- Background Fade Out -->
                    <DoubleAnimation Storyboard.TargetName="PinnedFolderOverlay" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15" />
                    <!-- Popup Zoom Out -->
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleX" From="1" To="0.95" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="FolderPopupScale" Storyboard.TargetProperty="ScaleY" From="1" To="0.95" Duration="0:0:0.15" />
                </Storyboard>
            </Grid.Resources>

            <Border x:Name="FolderPopupCard" Width="420" Height="320" CornerRadius="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">

                <Border.RenderTransform>
                    <ScaleTransform x:Name="FolderPopupScale" ScaleX="0.9" ScaleY="0.9" />
                </Border.RenderTransform>

                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Define the columns for Apps (Left) and Navigation (Right) -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Folder Title -->
                    <TextBox x:Name="OverlayFolderNameBox" Grid.Row="0" Grid.ColumnSpan="2" FontWeight="SemiBold" FontSize="16" 
                             Background="Transparent" BorderThickness="0" Margin="0,0,0,12"
                             HorizontalAlignment="Center" TextAlignment="Center" MinWidth="200"
                             KeyDown="OverlayFolderNameBox_KeyDown"
                             LostFocus="OverlayFolderNameBox_LostFocus"/>

                    <!-- Folder Apps Grid -->
                    <GridView x:Name="OverlayFolderGrid" Grid.Row="1" Grid.Column="0" SelectionMode="None" IsItemClickEnabled="True"
                              CanDragItems="True" AllowDrop="True" HorizontalAlignment="Center"
                              ItemTemplate="{StaticResource FlyoutFolderItemTemplate}"
                              ItemClick="OverlayFolderGrid_ItemClick"
                              DragItemsStarting="OverlayFolderGrid_DragItemsStarting"
                              DragItemsCompleted="OverlayFolderGrid_DragItemsCompleted">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <!-- Vertical Navigation Panel -->
                    <Grid x:Name="FolderVerticalNavigationGrid" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Spacing="12">

                            <!-- Up Button -->
                            <Button x:Name="FolderPageUpBtn" FontFamily="Segoe Fluent Icons" Content="&#xE70E;" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="4" Click="FolderPageUpBtn_Click" HorizontalAlignment="Center"/>

                            <!-- Page Indicators -->
                            <ItemsControl x:Name="FolderPageIndicatorControl" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="6" Margin="0,4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" Padding="0" BorderThickness="0" MinWidth="0" MinHeight="0" Click="FolderPageDotIndicator_Click">
                                            <Ellipse Width="6" Height="6" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" x:Name="DotIndicator"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Down Button -->
                            <Button x:Name="FolderPageDownBtn" FontFamily="Segoe Fluent Icons" Content="&#xE70D;" Background="Transparent" BorderThickness="0" Padding="8,4" CornerRadius="4" Click="FolderPageDownBtn_Click" HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>