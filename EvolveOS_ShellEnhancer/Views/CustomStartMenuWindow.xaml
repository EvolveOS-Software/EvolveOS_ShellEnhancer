<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomStartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_ShellEnhancer.Utilities.Helpers"
    mc:Ignorable="d"
    Title="CustomStartMenuWindow">

    <Grid Background="Transparent" PointerPressed="RootGrid_PointerPressed">

        <!-- Floating Menu Container -->
        <Border Background="Transparent" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="12" 
                Height="650" Width="750" x:Name="MenuContainer"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                PointerPressed="MenuContainer_PointerPressed">

            <Grid>
                <!-- 1: Split Standard -->
                <Grid x:Name="DesignSplitStandard" Visibility="Visible">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Pane: Apps & Search -->
                    <Grid Grid.Column="0" Padding="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <AutoSuggestBox Grid.Row="0" Height="40" PlaceholderText="Search Apps and files" 
                                            Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="20">
                            <AutoSuggestBox.QueryIcon>
                                <SymbolIcon Symbol="Find"/>
                            </AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>

                        <!-- Pinned Apps -->
                        <StackPanel Grid.Row="1" Margin="0,24,0,0">
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                <Button Content="All apps >" Background="Transparent" BorderThickness="0" 
                                            HorizontalAlignment="Right" FontSize="12" Click="BtnAllApps_Click"/>
                            </Grid>

                            <GridView x:Name="StandardPinnedAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:AppItem">
                                        <StackPanel Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent">
                                            <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                          Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>

                                            <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                       Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                </Image.RenderTransform>
                                            </Image>

                                            <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Grid>

                    <!-- Right Pane Background -->
                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,12,12,0" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,24">
                                <PersonPicture x:Name="ProfilePic1" Height="88" Width="88"/>
                                <TextBlock x:Name="ProfileName1" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Quick Folders -->
                            <StackPanel Grid.Row="1" Spacing="2">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Documents" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                        <TextBlock Text="Documents"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Downloads" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                        <TextBlock Text="Downloads"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Music" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                                        <TextBlock Text="Music"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Pictures" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                        <TextBlock Text="Pictures"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Settings" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                        <TextBlock Text="Settings"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Run" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE78B;" FontSize="16"/>
                                        <TextBlock Text="Run..."/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Power Options -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <DropDownButton Background="Transparent" BorderThickness="0">
                                    <DropDownButton.Content>
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Sleep" Click="PowerSleep_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE708;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem Text="Shut down" Click="PowerShutdown_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7E8;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem Text="Restart" Click="PowerRestart_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 2: Split Grouped -->
                <Grid x:Name="DesignSplitGrouped" Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Pane: Cards & Search -->
                    <Grid Grid.Column="0" Padding="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search -->
                        <AutoSuggestBox Grid.Row="0" Height="40" PlaceholderText="Search Apps and files" 
                                            Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="20">
                            <AutoSuggestBox.QueryIcon>
                                <SymbolIcon Symbol="Find"/>
                            </AutoSuggestBox.QueryIcon>
                        </AutoSuggestBox>

                        <ScrollViewer Grid.Row="1" Margin="0,24,0,0" VerticalScrollBarVisibility="Hidden">
                            <StackPanel Spacing="16">
                                <!-- Category Card 1 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Productivity" FontWeight="SemiBold" FontSize="14"/>
                                            <Button Content="All apps >" Background="Transparent" BorderThickness="0" 
                                                        HorizontalAlignment="Right" FontSize="12" Click="BtnAllApps_Click"/>
                                        </Grid>
                                        <GridView x:Name="ProductivityAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="helpers:AppItem">
                                                    <StackPanel Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent">
                                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Border>

                                <!-- Category Card 2 -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                                            <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Games" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="Photo" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <GridView x:Name="SecondaryAppsGrid" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="AppGrid_ItemClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="helpers:AppItem">
                                                    <StackPanel Width="80" Height="96" Spacing="4" Padding="4,8" CornerRadius="8" Background="Transparent">
                                                        <FontIcon Glyph="{x:Bind FallbackGlyph}" FontSize="32" HorizontalAlignment="Center"
                                                                      Visibility="{x:Bind HasNoIcon, Mode=OneWay}"/>
                                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                                   Visibility="{x:Bind HasIcon, Mode=OneWay}" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform ScaleX="{x:Bind IconScale}" ScaleY="{x:Bind IconScale}" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="None"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Pane -->
                    <Border Grid.Column="1" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,12,12,0" 
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                        <Grid Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="12" Margin="0,12,0,24">
                                <PersonPicture x:Name="ProfilePic2" Height="88" Width="88"/>
                                <TextBlock x:Name="ProfileName2" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Quick Folders -->
                            <StackPanel Grid.Row="1" Spacing="2">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Documents" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="16"/>
                                        <TextBlock Text="Documents"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Downloads" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                        <TextBlock Text="Downloads"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Music" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="16"/>
                                        <TextBlock Text="Music"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Pictures" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="16"/>
                                        <TextBlock Text="Pictures"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Settings" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                        <TextBlock Text="Settings"/>
                                    </StackPanel>
                                </Button>
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="12,10" Tag="Run" Click="QuickFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon Glyph="&#xE78B;" FontSize="16"/>
                                        <TextBlock Text="Run..."/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Power Options -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                <DropDownButton Background="Transparent" BorderThickness="0">
                                    <DropDownButton.Content>
                                        <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Sleep" Click="PowerSleep_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE708;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem Text="Shut down" Click="PowerShutdown_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE7E8;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem Text="Restart" Click="PowerRestart_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>