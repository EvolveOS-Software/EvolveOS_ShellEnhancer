<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_ShellEnhancer.Views.CustomStartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="CustomStartMenuWindow">

    <Grid Background="Transparent" PointerPressed="RootGrid_PointerPressed">
        <!-- Floating Menu Container -->
        <Border Background="Transparent" 
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="12" 
                Height="700" Width="600" x:Name="MenuContainer"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Search -->
                    <RowDefinition Height="*"/>
                    <!-- Pinned -->
                    <RowDefinition Height="Auto"/>
                    <!-- Recommended -->
                    <RowDefinition Height="64"/>
                    <!-- User/Power Footer -->
                </Grid.RowDefinitions>

                <!-- Search Bar -->
                <AutoSuggestBox Grid.Row="0" Margin="24,24,24,0" Height="40" PlaceholderText="Search apps, settings, and web">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find"/>
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>

                <!-- Pinned Apps Section -->
                <StackPanel Grid.Row="1" Padding="32,24,32,0">
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="14"/>
                        <Button Content="All apps >" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" FontSize="12"/>
                    </Grid>

                    <!-- Mockup of App Grid -->
                    <GridView SelectionMode="None">
                        <!-- Example App Icon 1 -->
                        <StackPanel Width="80" Height="80" Spacing="8" Padding="8" CornerRadius="4">
                            <FontIcon Glyph="&#xE7EF;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Edge" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Example App Icon 2 -->
                        <StackPanel Width="80" Height="80" Spacing="8" Padding="8" CornerRadius="4">
                            <FontIcon Glyph="&#xE713;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <!-- Example App Icon 3 -->
                        <StackPanel Width="80" Height="80" Spacing="8" Padding="8" CornerRadius="4">
                            <FontIcon Glyph="&#xE8F1;" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="Store" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </GridView>
                </StackPanel>

                <!-- Footer (Profile & Power) -->
                <Border Grid.Row="3" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="0,0,12,12" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <Grid Padding="24,0">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <PersonPicture Height="32" Width="32" DisplayName="User"/>
                            <TextBlock Text="User Profile" VerticalAlignment="Center" FontWeight="Medium"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="8">
                            <FontIcon Glyph="&#xE7E8;" FontSize="16"/>
                            <!-- Power Icon -->
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>