<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="EvolveOS_ShellEnhancer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_ShellEnhancer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Assets/Fonts/Fonts.xaml" />

            </ResourceDictionary.MergedDictionaries>
            
            <FontFamily x:Key="AppCustomFont">Segoe UI</FontFamily>

            <x:Double x:Key="AppFontSizeBase">14</x:Double>
            <x:Double x:Key="AppFontSizeSmall">12</x:Double>
            <x:Double x:Key="AppFontSizeTiny">10</x:Double>
            <x:Double x:Key="AppFontSizeHeader">18</x:Double>
            <x:Double x:Key="AppFontSizeTitle">24</x:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>
