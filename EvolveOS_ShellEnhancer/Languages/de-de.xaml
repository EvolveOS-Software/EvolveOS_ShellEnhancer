<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">

    <!-- region Message Window -->

    <!-- Shared Message Window Strings -->
    <sys:String x:Key="noty_message">Diese Anwendung wird automatisch geschlossen</sys:String>
    <sys:String x:Key="button_message">Akzeptieren</sys:String>

    <!-- General Warning Message -->
    <sys:String x:Key="title_message">Anwendungswarnung</sys:String>
    <sys:String x:Key="part1_message">Sie sind dabei, eine</sys:String>
    <sys:String x:Key="part2_message">experimentelle Funktion</sys:String>
    <sys:String x:Key="part3_message">zu starten. Bitte gehen Sie mit Vorsicht vor, da dies zu Systeminstabilität führen kann.</sys:String>

    <!-- Not Supported Message -->
    <sys:String x:Key="title_nosupport_message">Nicht unterstütztes System</sys:String>
    <sys:String x:Key="part1_nosupport_message">Ihre aktuelle</sys:String>
    <sys:String x:Key="part2_nosupport_message">Betriebssystemversion</sys:String>
    <sys:String x:Key="part3_nosupport_message">wird von diesem Build des EvolveOS Shell Enhancers nicht vollständig unterstützt.</sys:String>

    <!-- Already Running Message -->
    <sys:String x:Key="title_alreadyrunning_message">Anwendung läuft bereits</sys:String>
    <sys:String x:Key="part1_alreadyrunning_message">Eine Instanz von</sys:String>
    <sys:String x:Key="part2_alreadyrunning_message">EvolveOS Shell Enhancer</sys:String>
    <sys:String x:Key="part3_alreadyrunning_message">wird bereits im Hintergrund ausgeführt. Bitte überprüfen Sie Ihre Taskleiste.</sys:String>

    <!-- Missing Optimizer Message -->
    <sys:String x:Key="title_missingoptimizer_message">Fehlende Kernkomponente</sys:String>
    <sys:String x:Key="part1_missingoptimizer_message">Die Anwendung</sys:String>
    <sys:String x:Key="part2_missingoptimizer_message">EvolveOS Optimizer</sys:String>
    <sys:String x:Key="part3_missingoptimizer_message">konnte nicht gefunden werden. Bitte stellen Sie sicher, dass sie sich im exakt selben Verzeichnis wie der Shell Enhancer befindet, um fortzufahren.</sys:String>

    <!-- endregion Message Window -->

    <!-- region TaskBar -->

    <!-- endregion TaskBar -->

    <!-- region StartMenu -->

    <!-- Front-end Strings -->
    <sys:String x:Key="StartMenu_SearchPlaceholder">Nach Apps und Dateien suchen</sys:String>
    <sys:String x:Key="StartMenu_FilterApps">Apps</sys:String>
    <sys:String x:Key="StartMenu_FilterFiles">Dateien</sys:String>
    <sys:String x:Key="StartMenu_FilterWeb">Web</sys:String>
    <sys:String x:Key="StartMenu_Pinned">Angeheftet</sys:String>
    <sys:String x:Key="StartMenu_AllApps">Alle Apps &gt;</sys:String>
    <sys:String x:Key="StartMenu_CategoryProductivity">Produktivität</sys:String>
    <sys:String x:Key="StartMenu_CategoryNotes">Notizen</sys:String>
    <sys:String x:Key="StartMenu_CategoryGames">Spiele</sys:String>
    <sys:String x:Key="StartMenu_CategoryPhoto">Fotos</sys:String>
    <sys:String x:Key="StartMenu_FolderDocuments">Dokumente</sys:String>
    <sys:String x:Key="StartMenu_FolderDownloads">Downloads</sys:String>
    <sys:String x:Key="StartMenu_FolderMusic">Musik</sys:String>
    <sys:String x:Key="StartMenu_FolderPictures">Bilder</sys:String>
    <sys:String x:Key="StartMenu_FolderSettings">Einstellungen</sys:String>
    <sys:String x:Key="StartMenu_FolderRun">Ausführen...</sys:String>
    <sys:String x:Key="StartMenu_PowerSleep">Energie sparen</sys:String>
    <sys:String x:Key="StartMenu_PowerShutdown">Herunterfahren</sys:String>
    <sys:String x:Key="StartMenu_PowerRestart">Neu starten</sys:String>
    <sys:String x:Key="StartMenu_ActionOpen">Öffnen</sys:String>
    <sys:String x:Key="StartMenu_ActionRunAsAdmin">Als Administrator ausführen</sys:String>
    <sys:String x:Key="StartMenu_ActionOpenLocation">Dateipfad öffnen</sys:String>

    <sys:String x:Key="StartMenu_AccountSettings">Kontoeinstellungen</sys:String>
    <sys:String x:Key="StartMenu_MyAccount">Mein Konto verwalten</sys:String>
    <sys:String x:Key="StartMenu_Lock">Sperren</sys:String>
    <sys:String x:Key="StartMenu_SignOut">Abmelden</sys:String>

    <!-- Back-end Strings -->
    <sys:String x:Key="StartMenu_BackToPinned">&lt; Zurück zu Angeheftet</sys:String>
    <sys:String x:Key="StartMenu_ContextPinStart">An Start anheften</sys:String>
    <sys:String x:Key="StartMenu_ContextUnpinStart">Von Start lösen</sys:String>
    <sys:String x:Key="StartMenu_ContextPinTaskbar">An Taskleiste anheften</sys:String>
    <sys:String x:Key="StartMenu_ContextUnpinTaskbar">Von Taskleiste lösen</sys:String>
    <sys:String x:Key="StartMenu_SearchNoResults">Keine Ergebnisse gefunden</sys:String>

    <!-- We use {0} as a placeholder for the user's search query -->
    <sys:String x:Key="StartMenu_SearchPCPrefix">Gesamten PC nach '{0}' durchsuchen</sys:String>
    <sys:String x:Key="StartMenu_SearchWebPrefix">Im Web nach '{0}' suchen</sys:String>

    <!-- endregion StartMenu -->

</ResourceDictionary>
