    <sys:String x:Key="StartMenu_CategoryProductivity">Productividad</sys:String>
    <sys:String x:Key="StartMenu_CategoryNotes">Notas</sys:String>
    <sys:String x:Key="StartMenu_CategoryGames">Juegos</sys:String>
