    <sys:String x:Key="StartMenu_Rename">Cambiar nombre</sys:String>
    <sys:String x:Key="StartMenu_New">Nuevo</sys:String>
    <sys:String x:Key="StartMenu_AddGroup">Agregar grupo</sys:String>
