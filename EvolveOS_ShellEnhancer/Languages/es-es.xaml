    <!-- Dialogs (Rename Page & Pin Website) -->
    <sys:String x:Key="StartMenu_RenamePage">Cambiar nombre de página</sys:String>
    <sys:String x:Key="StartMenu_Save">Guardar</sys:String>
    <sys:String x:Key="StartMenu_Cancel">Cancelar</sys:String>
    <sys:String x:Key="StartMenu_WebsiteName">Nombre del sitio web (ej. Google)</sys:String>
    <sys:String x:Key="StartMenu_WebsiteUrl">URL (ej. https://google.com)</sys:String>

    <!-- Default Generated Names -->
    <sys:String x:Key="StartMenu_NewGroup">Nuevo grupo</sys:String>
    <sys:String x:Key="StartMenu_NewTabbedGroup">Nuevo grupo con pestañas</sys:String>
    <sys:String x:Key="StartMenu_NewPage">Nueva página</sys:String>
    <sys:String x:Key="StartMenu_DefaultFolderName">Carpeta</sys:String>
    <sys:String x:Key="StartMenu_DefaultAppName">Aplicación</sys:String>
    <sys:String x:Key="StartMenu_PinnedCategory">Anclado</sys:String>

    <!-- Tabbed Group Controls -->
    <sys:String x:Key="StartMenu_NewTab">Nueva pestaña</sys:String>
    <sys:String x:Key="StartMenu_RenameTab">Cambiar nombre de pestaña</sys:String>
    <sys:String x:Key="StartMenu_RemoveTab">Quitar</sys:String>
    <sys:String x:Key="StartMenu_DeleteEntireGroup">Eliminar todo el grupo</sys:String>

    <!-- Tabbed Group Manager -->
    <sys:String x:Key="StartMenu_ManageTabsAndColors">Administrar pestañas y colores</sys:String>
    <sys:String x:Key="StartMenu_TabName">Nombre de la pestaña</sys:String>
    <sys:String x:Key="StartMenu_TabNamePlaceholder">Ingrese el nombre de la pestaña...</sys:String>
    <sys:String x:Key="StartMenu_TabColor">Color de la pestaña</sys:String>
    <sys:String x:Key="StartMenu_CustomHexColor">Color hex personalizado</sys:String>
    <sys:String x:Key="StartMenu_ApplyCustomColor">Aplicar color personalizado</sys:String>
    <sys:String x:Key="StartMenu_SaveSetup">Guardar configuración</sys:String>

    <!-- endregion StartMenu -->

</ResourceDictionary>
