<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">

    <!-- region Message Window -->

    <!-- Shared Message Window Strings -->
    <sys:String x:Key="noty_message">Esta aplicación se cerrará automáticamente</sys:String>
    <sys:String x:Key="button_message">Aceptar</sys:String>

    <!-- General Warning Message -->
    <sys:String x:Key="title_message">Advertencia de la aplicación</sys:String>
    <sys:String x:Key="part1_message">Estás a punto de iniciar una</sys:String>
    <sys:String x:Key="part2_message">función experimental</sys:String>
    <sys:String x:Key="part3_message">. Procede con precaución, ya que esto podría causar inestabilidad en el sistema.</sys:String>

    <!-- Not Supported Message -->
    <sys:String x:Key="title_nosupport_message">Sistema no compatible</sys:String>
    <sys:String x:Key="part1_nosupport_message">Tu</sys:String>
    <sys:String x:Key="part2_nosupport_message">versión actual del sistema operativo</sys:String>
    <sys:String x:Key="part3_nosupport_message">no es totalmente compatible con esta compilación de EvolveOS Shell Enhancer.</sys:String>

    <!-- Already Running Message -->
    <sys:String x:Key="title_alreadyrunning_message">La aplicación ya se está ejecutando</sys:String>
    <sys:String x:Key="part1_alreadyrunning_message">Una instancia de</sys:String>
    <sys:String x:Key="part2_alreadyrunning_message">EvolveOS Shell Enhancer</sys:String>
    <sys:String x:Key="part3_alreadyrunning_message">ya se está ejecutando en segundo plano. Comprueba la bandeja del sistema.</sys:String>

    <!-- Missing Optimizer Message -->
    <sys:String x:Key="title_missingoptimizer_message">Falta un componente principal</sys:String>
    <sys:String x:Key="part1_missingoptimizer_message">No se pudo encontrar la aplicación</sys:String>
    <sys:String x:Key="part2_missingoptimizer_message">EvolveOS Optimizer</sys:String>
    <sys:String x:Key="part3_missingoptimizer_message">. Asegúrate de que se encuentre exactamente en el mismo directorio que Shell Enhancer para continuar.</sys:String>

    <!-- endregion Message Window -->

    <!-- region TaskBar -->

    <!-- Back-end Strings -->
    <sys:String x:Key="Taskbar_TaskManager">Administrador de tareas</sys:String>
    <sys:String x:Key="Taskbar_Settings">Configuración de barra</sys:String>
    <sys:String x:Key="Taskbar_CloseWindow">Cerrar ventana</sys:String>
    <sys:String x:Key="Taskbar_UnpinTaskbar">Desanclar de la barra</sys:String>
    <sys:String x:Key="Taskbar_EmptyFolder">Carpeta vacía</sys:String>

    <!-- endregion TaskBar -->

    <!-- region StartMenu -->

    <!-- Front-end Strings -->
    <sys:String x:Key="StartMenu_SearchPlaceholder">Buscar aplicaciones y archivos</sys:String>
    <sys:String x:Key="StartMenu_FilterApps">Aplicaciones</sys:String>
    <sys:String x:Key="StartMenu_FilterFiles">Archivos</sys:String>
    <sys:String x:Key="StartMenu_FilterWeb">Web</sys:String>
    <sys:String x:Key="StartMenu_Pinned">Anclado</sys:String>
    <sys:String x:Key="StartMenu_AllApps">Todas las aplicaciones &gt;</sys:String>
    <sys:String x:Key="StartMenu_CategoryProductivity">Productividad</sys:String>
    <sys:String x:Key="StartMenu_CategoryNotes">Notas</sys:String>
    <sys:String x:Key="StartMenu_CategoryGames">Juegos</sys:String>
    <sys:String x:Key="StartMenu_CategoryPhoto">Fotos</sys:String>
    <sys:String x:Key="StartMenu_FolderDocuments">Documentos</sys:String>
    <sys:String x:Key="StartMenu_FolderDownloads">Descargas</sys:String>
    <sys:String x:Key="StartMenu_FolderMusic">Música</sys:String>
    <sys:String x:Key="StartMenu_FolderPictures">Imágenes</sys:String>
    <sys:String x:Key="StartMenu_FolderSettings">Configuración</sys:String>
    <sys:String x:Key="StartMenu_FolderRun">Ejecutar...</sys:String>
    <sys:String x:Key="StartMenu_PowerSleep">Suspender</sys:String>
    <sys:String x:Key="StartMenu_PowerShutdown">Apagar</sys:String>
    <sys:String x:Key="StartMenu_PowerRestart">Reiniciar</sys:String>
    <sys:String x:Key="StartMenu_PowerLogOff">Cerrar sesión</sys:String>
    <sys:String x:Key="StartMenu_PowerRestartBios">Reiniciar a BIOS</sys:String>
    <sys:String x:Key="StartMenu_ActionOpen">Abrir</sys:String>
    <sys:String x:Key="StartMenu_ActionRunAsAdmin">Ejecutar como administrador</sys:String>
    <sys:String x:Key="StartMenu_ActionOpenLocation">Abrir ubicación de archivo</sys:String>

    <sys:String x:Key="StartMenu_AccountSettings">Configuración de la cuenta</sys:String>
    <sys:String x:Key="StartMenu_MyAccount">Administrar mi cuenta</sys:String>
    <sys:String x:Key="StartMenu_Lock">Bloquear</sys:String>
    <sys:String x:Key="StartMenu_SignOut">Cerrar sesión</sys:String>

    <!-- Back-end Strings -->
    <sys:String x:Key="StartMenu_BackToPinned">&lt; Volver a Anclado</sys:String>
    <sys:String x:Key="StartMenu_ContextPinStart">Anclar a Inicio</sys:String>
    <sys:String x:Key="StartMenu_ContextUnpinStart">Desanclar de Inicio</sys:String>
    <sys:String x:Key="StartMenu_ContextPinTaskbar">Anclar a la barra de tareas</sys:String>
    <sys:String x:Key="StartMenu_ContextUnpinTaskbar">Desanclar de la barra de tareas</sys:String>
    <sys:String x:Key="StartMenu_SearchNoResults">No se encontraron resultados</sys:String>

    <!-- We use {0} as a placeholder for the user's search query -->
    <sys:String x:Key="StartMenu_SearchPCPrefix">Buscar '{0}' en todo el equipo</sys:String>
    <sys:String x:Key="StartMenu_SearchWebPrefix">Buscar '{0}' en la web</sys:String>

    <!-- endregion StartMenu -->

</ResourceDictionary>
