<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">

    <!-- region Message Window -->

    <!-- Shared Message Window Strings -->
    <sys:String x:Key="noty_message">Questa applicazione si chiuderà automaticamente</sys:String>
    <sys:String x:Key="button_message">Accetta</sys:String>

    <!-- General Warning Message -->
    <sys:String x:Key="title_message">Avviso dell'applicazione</sys:String>
    <sys:String x:Key="part1_message">Stai per avviare una</sys:String>
    <sys:String x:Key="part2_message">funzionalità sperimentale</sys:String>
    <sys:String x:Key="part3_message">. Procedi con cautela poiché ciò potrebbe causare instabilità al sistema.</sys:String>

    <!-- Not Supported Message -->
    <sys:String x:Key="title_nosupport_message">Sistema non supportato</sys:String>
    <sys:String x:Key="part1_nosupport_message">La tua attuale</sys:String>
    <sys:String x:Key="part2_nosupport_message">versione del sistema operativo</sys:String>
    <sys:String x:Key="part3_nosupport_message">non è completamente supportata da questa build di EvolveOS Shell Enhancer.</sys:String>

    <!-- Already Running Message -->
    <sys:String x:Key="title_alreadyrunning_message">Applicazione già in esecuzione</sys:String>
    <sys:String x:Key="part1_alreadyrunning_message">Un'istanza di</sys:String>
    <sys:String x:Key="part2_alreadyrunning_message">EvolveOS Shell Enhancer</sys:String>
    <sys:String x:Key="part3_alreadyrunning_message">è già in esecuzione in background. Controlla l'area di notifica.</sys:String>

    <!-- Missing Optimizer Message -->
    <sys:String x:Key="title_missingoptimizer_message">Componente principale mancante</sys:String>
    <sys:String x:Key="part1_missingoptimizer_message">L'applicazione</sys:String>
    <sys:String x:Key="part2_missingoptimizer_message">EvolveOS Optimizer</sys:String>
    <sys:String x:Key="part3_missingoptimizer_message">non è stata trovata. Assicurati che si trovi esattamente nella stessa directory di Shell Enhancer per continuare.</sys:String>

    <!-- endregion Message Window -->

    <!-- region TaskBar -->

    <!-- Back-end Strings -->
    <sys:String x:Key="Taskbar_TaskManager">Gestione attività</sys:String>
    <sys:String x:Key="Taskbar_Settings">Impostazioni barra</sys:String>
    <sys:String x:Key="Taskbar_RestartShell">Riavvia shell</sys:String>
    <sys:String x:Key="Taskbar_CloseWindow">Chiudi finestra</sys:String>
    <sys:String x:Key="Taskbar_UnpinTaskbar">Rimuovi dalla barra</sys:String>
    <sys:String x:Key="Taskbar_EmptyFolder">Cartella vuota</sys:String>

    <!-- endregion TaskBar -->

    <!-- region StartMenu -->

    <!-- Front-end Strings -->
    <sys:String x:Key="StartMenu_SearchPlaceholder">Cerca app e file</sys:String>
    <sys:String x:Key="StartMenu_FilterApps">App</sys:String>
    <sys:String x:Key="StartMenu_FilterFiles">File</sys:String>
    <sys:String x:Key="StartMenu_FilterWeb">Web</sys:String>
    <sys:String x:Key="StartMenu_Pinned">Aggiunti</sys:String>
    <sys:String x:Key="StartMenu_AllApps">Tutte le app &gt;</sys:String>
    <sys:String x:Key="StartMenu_CategoryProductivity">Produttività</sys:String>
    <sys:String x:Key="StartMenu_CategoryNotes">Note</sys:String>
    <sys:String x:Key="StartMenu_CategoryGames">Giochi</sys:String>
    <sys:String x:Key="StartMenu_CategoryPhoto">Foto</sys:String>
    <sys:String x:Key="StartMenu_FolderDocuments">Documenti</sys:String>
    <sys:String x:Key="StartMenu_FolderDownloads">Download</sys:String>
    <sys:String x:Key="StartMenu_FolderMusic">Musica</sys:String>
    <sys:String x:Key="StartMenu_FolderPictures">Immagini</sys:String>
    <sys:String x:Key="StartMenu_FolderSettings">Impostazioni</sys:String>
    <sys:String x:Key="StartMenu_FolderRun">Esegui...</sys:String>
    <sys:String x:Key="StartMenu_PowerSleep">Sospendi</sys:String>
    <sys:String x:Key="StartMenu_PowerShutdown">Arresta il sistema</sys:String>
    <sys:String x:Key="StartMenu_PowerRestart">Riavvia il sistema</sys:String>
    <sys:String x:Key="StartMenu_PowerLogOff">Disconnetti</sys:String>
    <sys:String x:Key="StartMenu_PowerRestartBios">Riavvia nel BIOS</sys:String>
    <sys:String x:Key="StartMenu_ActionOpen">Apri</sys:String>
    <sys:String x:Key="StartMenu_ActionRunAsAdmin">Esegui come amministratore</sys:String>
    <sys:String x:Key="StartMenu_ActionOpenLocation">Apri percorso file</sys:String>

    <sys:String x:Key="StartMenu_AccountSettings">Impostazioni account</sys:String>
    <sys:String x:Key="StartMenu_MyAccount">Gestisci il mio account</sys:String>
    <sys:String x:Key="StartMenu_Lock">Blocca</sys:String>
    <sys:String x:Key="StartMenu_SignOut">Disconnetti</sys:String>

    <!-- Back-end Strings -->
    <sys:String x:Key="StartMenu_BackToPinned">&lt; Torna ad Aggiunti</sys:String>
    <sys:String x:Key="StartMenu_ContextPinStart">Aggiungi a Start</sys:String>
    <sys:String x:Key="StartMenu_ContextUnpinStart">Rimuovi da Start</sys:String>
    <sys:String x:Key="StartMenu_ContextPinTaskbar">Aggiungi alla barra delle applicazioni</sys:String>
    <sys:String x:Key="StartMenu_ContextUnpinTaskbar">Rimuovi dalla barra delle applicazioni</sys:String>
    <sys:String x:Key="StartMenu_SearchNoResults">Nessun risultato trovato</sys:String>

    <!-- We use {0} as a placeholder for the user's search query -->
    <sys:String x:Key="StartMenu_SearchPCPrefix">Cerca '{0}' nell'intero PC</sys:String>
    <sys:String x:Key="StartMenu_SearchWebPrefix">Cerca '{0}' nel Web</sys:String>

    <!-- endregion StartMenu -->

</ResourceDictionary>
